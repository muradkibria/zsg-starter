# DigiLite — one environment for everything in this repo: the PocketBase
# service (pocketbase/), its schema script, and the dashboard (dashboard/).
# Copy to .env (`npm run setup` in dashboard/ does this for you). On a host like
# Railway, set the same variables once as shared variables for every service.
# Never commit .env: it holds the database and Colorlight passwords.

# ── PocketBase: the database ─────────────────────────────────────────────────
# Where the dashboard and the schema script reach it (no trailing slash).
POCKETBASE_URL=http://127.0.0.1:8190
# The superuser, for PocketBase's admin page and the API server. The PocketBase
# container creates or updates it at every boot. Password: 8+ characters, long and
# random. (The dashboard itself doesn't use it: everyone has a six-digit code.)
POCKETBASE_EMAIL=superuser@digilite.local
POCKETBASE_PASSWORD=

# ── Colorlight Cloud: where every bag's data comes from ─────────────────────
COLORLIGHT_USERNAME=
COLORLIGHT_PASSWORD=

# ── Optional: everything below has a default; uncomment to change it ────────
# Changes to bags (brightness, restart, schedules, loops): off = dry run, nothing
# sent; test = the test bag(s) only; fleet = any bag, and only while the owner's
# "Allow changes to the whole fleet" switch is on in Settings.
# COLORLIGHT_WRITES=off
# COLORLIGHT_TEST_BAG_IDS=5786440
# Days recorded first on start, then how far back older history is imported.
# SYNC_BACKFILL_DAYS=14
# SYNC_HISTORY_DAYS=200
# SYNC_ENABLED=true
# Signs dashboard sessions. By default it's worked out from POCKETBASE_PASSWORD,
# so changing that password signs everyone out of the dashboard.
# SESSION_SECRET=
# The API server's port (else PORT, as hosts set it, else 4000) and address.
# API_PORT=4000
# API_HOST=127.0.0.1
# COLORLIGHT_API_BASE=https://beu.colorlightcloud.com
